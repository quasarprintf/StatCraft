<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="StatCraft.App"
             xmlns:local="using:StatCraft"
             RequestedThemeVariant="Default">
             <!-- "Default" ThemeVariant follows system theme variant. "Dark" or "Light" are other available options. -->

    <Application.DataTemplates>
        <local:ViewLocator/>
    </Application.DataTemplates>
  
    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Fluent.xaml"/>

        <Style Selector="Button.active">
            <Setter Property="Background" Value="{DynamicResource SystemAccentColor}"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style Selector="Button.active:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SystemAccentColor}"/>
        </Style>

        <Style Selector="GridSplitter">
            <Setter Property="Background" Value="Gray"/>
            <Setter Property="Width" Value="1"/>
            <Setter Property="MinWidth" Value="1"/>
        </Style>

        <!-- Leaf TreeViewItems (no children, FluentTheme's own ":empty" pseudo-class) show a short line
             instead of a blank chevron slot. Re-shows the theme's own chevron ToggleButton (which the
             theme otherwise hides via IsVisible=False for empty items, while still reserving its layout
             space), hides its Path glyph, and reskins its Border into a thin line — so it sits in the
             exact same slot a real chevron would, pixel-perfect, with no computed offset needed. Applies
             to any TreeView in the app, not just the Builds tab's. -->
        <Style Selector="TreeViewItem:empty /template/ ToggleButton#PART_ExpandCollapseChevron">
            <Setter Property="IsVisible" Value="True"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
        </Style>
        <Style Selector="TreeViewItem:empty /template/ ToggleButton#PART_ExpandCollapseChevron /template/ Path#ChevronPath">
            <Setter Property="IsVisible" Value="False"/>
        </Style>
        <Style Selector="TreeViewItem:empty /template/ ToggleButton#PART_ExpandCollapseChevron /template/ Border">
            <Setter Property="Background" Value="Gray"/>
            <Setter Property="Height" Value="1"/>
        </Style>
    </Application.Styles>
</Application>