<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="StatCraft.App"
             RequestedThemeVariant="Default">
             <!-- "Default" ThemeVariant follows system theme variant. "Dark" or "Light" are other available options. -->

    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Fluent.xaml"/>

        <Style Selector="Button.active">
            <Setter Property="Background" Value="{DynamicResource SystemAccentColor}"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style Selector="Button.active:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SystemAccentColor}"/>
        </Style>

        <Style Selector="GridSplitter">
            <Setter Property="Background" Value="Gray"/>
            <Setter Property="Width" Value="1"/>
            <Setter Property="MinWidth" Value="1"/>
        </Style>

        <!-- Shared by the Data and Maps tabs' filter bars: one filter's editor + its remove button. -->
        <Style Selector="StackPanel.filterSlot">
            <Setter Property="Orientation" Value="Horizontal"/>
            <Setter Property="Spacing" Value="2"/>
        </Style>
        <Style Selector="Button.removeFilter">
            <Setter Property="Content" Value="✕"/>
            <Setter Property="Foreground" Value="Red"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- Leaf TreeViewItems (no children, FluentTheme's own ":empty" pseudo-class) show a short line instead of a blank chevron slot. 
            Re-shows the theme's own chevron ToggleButton, hides its Path glyph, and reskins its Border into a thin line. -->
        <Style Selector="TreeViewItem:empty /template/ ToggleButton#PART_ExpandCollapseChevron">
            <Setter Property="IsVisible" Value="True"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
        </Style>
        <Style Selector="TreeViewItem:empty /template/ ToggleButton#PART_ExpandCollapseChevron /template/ Path#ChevronPath">
            <Setter Property="IsVisible" Value="False"/>
        </Style>
        <Style Selector="TreeViewItem:empty /template/ ToggleButton#PART_ExpandCollapseChevron /template/ Border">
            <Setter Property="Background" Value="Gray"/>
            <Setter Property="Height" Value="1"/>
        </Style>

        <!-- Hides the FluentTheme ComboBox's dropdown chevron, for ComboBoxes styled to look like plain
            inline text rather than a form field. The chevron (PathIcon#DropDownGlyph) lives in a fixed
            32px second column of the template's root Grid (ColumnDefinitions="*,32", not itself stylable),
            so hiding just the icon leaves that column's space reserved and blank. Instead, the content
            elements that normally occupy only column 0 are stretched across both columns, reclaiming it. -->
        <Style Selector="ComboBox.noCaret /template/ PathIcon#DropDownGlyph">
            <Setter Property="IsVisible" Value="False"/>
        </Style>
        <Style Selector="ComboBox.noCaret /template/ TextBlock#PlaceholderTextBlock">
            <Setter Property="Grid.ColumnSpan" Value="2"/>
        </Style>
        <Style Selector="ComboBox.noCaret /template/ ContentControl#ContentPresenter">
            <Setter Property="Grid.ColumnSpan" Value="2"/>
        </Style>
        <Style Selector="ComboBox.noCaret /template/ TextBox#PART_EditableTextBox">
            <Setter Property="Grid.ColumnSpan" Value="2"/>
        </Style>

        <!-- Removes the left margin from DataGrid column headers -->
        <Style Selector="DataGridColumnHeader">
            <Setter Property="Padding" Value="1"/>
            <Setter Property="HorizontalContentAlignment" Value="Center" />
        </Style>
    </Application.Styles>
    <Application.Resources>
        <!--Removes the right margin from DataGrid column headers-->
        <x:Double x:Key="DataGridSortIconMinWidth">1</x:Double>

        <!-- Removes the horizontal margin DataGridTextColumn puts on its auto-generated cell TextBlock
            (Margin="12,0,12,0" in the DataGrid FluentTheme). DataGridTextColumn looks this ControlTheme
            up by name via OwningGrid.TryFindResource rather than through a Style selector, so it has to
            be replaced here rather than overridden with a Style like the column header padding was. -->
        <ControlTheme x:Key="DataGridCellTextBlockTheme" TargetType="TextBlock">
            <Setter Property="Margin" Value="1"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </ControlTheme>
    </Application.Resources>
</Application>