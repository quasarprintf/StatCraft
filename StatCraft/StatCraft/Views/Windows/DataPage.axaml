<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:StatCraft.ViewModels"
             xmlns:local="using:StatCraft.Views"
             xmlns:component="using:StatCraft.Views.Components"
              x:Class="StatCraft.Views.DataPage"
             x:DataType="vm:DataPageViewModel">
    <DockPanel>
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="12" Margin="8">
            <Button Content="Begin Session" Command="{Binding BeginSessionCommand}" IsVisible="{Binding !HasActiveSession}"/>
            <Button Content="End Session" Command="{Binding EndSessionCommand}" IsVisible="{Binding HasActiveSession}"/>
            <Button Content="Import Replay" Command="{Binding ImportReplayCommand}" IsVisible="{Binding HasActiveSession}"/>

            <TextBlock Text="{Binding ActiveProfileLabel}" FontSize="16" VerticalAlignment="Center"/>
            <!-- One entry per race the active profile has a current ladder rating on. -->
            <ItemsControl ItemsSource="{Binding CurrentMmrs}" VerticalAlignment="Center">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" Spacing="10"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:RaceMmrViewModel">
                        <component:ColoredTextBlock Characters="{Binding Characters}"
                                                    FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Record over the currently filtered games, so it reflects whatever the filters are asking. -->
            <TextBlock Text="{Binding WinRateLabel}" FontSize="16" FontWeight="Bold"
                       VerticalAlignment="Center"/>
        </StackPanel>

        <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="8,0,8,8">
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <local:CheckboxFilterDropdown Header="{Binding Filters.ProfileSlot.Title}" Options="{Binding Filters.ProfileSlot.Options}"
                                               ShowSearch="{Binding Filters.ProfileSlot.ShowSearch}" SearchText="{Binding Filters.ProfileSlot.SearchText}"/>
                <local:CompactDatePicker SelectedDate="{Binding Filters.FromDate}"/>
                <TextBlock Text="to" VerticalAlignment="Center"/>
                <local:CompactDatePicker SelectedDate="{Binding Filters.ToDate}"/>

                <ItemsControl ItemsSource="{Binding Filters.VisibleExtraFilterSlots}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="8"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.DataTemplates>
                        <DataTemplate x:DataType="vm:CheckboxFilterSlotViewModel">
                            <StackPanel Classes="filterSlot">
                                <local:CheckboxFilterDropdown Header="{Binding Title}" Options="{Binding Options}"
                                                               ShowSearch="{Binding ShowSearch}" SearchText="{Binding SearchText}"
                                                               Columns="{Binding Columns}"/>
                                <Button Classes="removeFilter" Command="{Binding RemoveCommand}"/>
                            </StackPanel>
                        </DataTemplate>
                        <DataTemplate x:DataType="vm:NumericRangeFilterSlotViewModel">
                            <StackPanel Classes="filterSlot">
                                <TextBlock Text="{Binding Title}" VerticalAlignment="Center"/>
                                <NumericUpDown Value="{Binding Min}" Width="60" PlaceholderText="Min" FormatString="0" ShowButtonSpinner="False"/>
                                <TextBlock Text="-" VerticalAlignment="Center"/>
                                <NumericUpDown Value="{Binding Max}" Width="60" PlaceholderText="Max" FormatString="0" ShowButtonSpinner="False"/>
                                <Button Classes="removeFilter" Command="{Binding RemoveCommand}"/>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.DataTemplates>
                </ItemsControl>
            </StackPanel>

            <Button Grid.Column="1" Content="+ Filters" VerticalAlignment="Center">
                <Button.Flyout>
                    <MenuFlyout ItemsSource="{Binding Filters.HiddenExtraFilterSlots}" Placement="BottomEdgeAlignedRight">
                        <MenuFlyout.ItemContainerTheme>
                            <ControlTheme TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}" x:DataType="vm:FilterSlotViewModel">
                                <Setter Property="Header" Value="{Binding Title}"/>
                                <Setter Property="Command" Value="{Binding AddCommand}"/>
                            </ControlTheme>
                        </MenuFlyout.ItemContainerTheme>
                    </MenuFlyout>
                </Button.Flyout>
            </Button>
        </Grid>

        <!-- Details are driven per-row from code-behind (see DataPage.axaml.cs) rather than by selection,
             so the build panel only opens from the Build column. -->
        <!-- Known limitation: scrolling near the bottom of a long list can occasionally snap back to the
             top. That's an open, unfixed bug in Avalonia.Controls.DataGrid's own virtualization/scroll-
             offset handling (see AvaloniaUI/Avalonia.Controls.DataGrid#70 and #148 — no fix or workaround
             from upstream as of 12.1.0), not something in StatCraft's own code — nothing to chase here. -->
        <DataGrid x:Name="GamesGrid" ItemsSource="{Binding Games}" AutoGenerateColumns="False"
                  RowDetailsVisibilityMode="Collapsed" GridLinesVisibility="All">
            <DataGrid.Columns>
                <DataGridTemplateColumn Width="36" CanUserResize="False" CanUserSort="False">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="vm:GameDataRowViewModel">
                            <Button Content="✕" Foreground="Red" Background="Transparent" BorderThickness="0"
                                    FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"
                                    Command="{Binding $parent[DataGrid].((vm:DataPageViewModel)DataContext).DeleteGameCommand}"
                                    CommandParameter="{Binding}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Profile" Binding="{Binding ProfileLabel}" IsReadOnly="True"/>
                <DataGridTextColumn Header="Date/Time" Binding="{Binding PlayedAt}" IsReadOnly="True"/>
                <!-- Always an editable dropdown rather than click-to-edit: Ranked vs Unranked is
                     inferred and can be wrong, so correcting it should be obvious and one click. -->
                <DataGridTemplateColumn Header="Mode">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="vm:GameDataRowViewModel">
                            <ComboBox ItemsSource="{Binding GameTypeOptions}" SelectedItem="{Binding GameType}"
                                      Classes="noCaret" Width="30" Margin="2,0" VerticalAlignment="Center" Padding="0" BorderThickness="0"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Map" Binding="{Binding MapName}" IsReadOnly="True"/>
                <DataGridTemplateColumn Header="Result">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="vm:GameDataRowViewModel">
                            <TextBlock Text="{Binding ResultLabel}" Foreground="{Binding ResultColor}"
                                       VerticalAlignment="Center"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="MMR(Δ)">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="vm:GameDataRowViewModel">
                            <component:ColoredTextBlock Characters="{Binding MmrText}"
                                                        VerticalAlignment="Center"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Length" Binding="{Binding GameLength}" IsReadOnly="True"/>
                <DataGridTemplateColumn Header="Matchup">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="vm:GameDataRowViewModel">
                            <component:ColoredTextBlock Characters="{Binding MatchupCharacters}"
                                                     VerticalAlignment="Center"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Opponent" Binding="{Binding OpponentName}" IsReadOnly="True"/>
                <DataGridTextColumn Header="Build" Binding="{Binding SelfTracker.SelectedBuildsSummary}" IsReadOnly="True"/>
                <DataGridTextColumn Header="Notes" Binding="{Binding Notes}" Width="*"/>
                <DataGridTemplateColumn Width="36" CanUserResize="False" CanUserSort="False">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="vm:GameDataRowViewModel">
                            <Button Content="▶" Background="Transparent" BorderThickness="0"
                                    FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"
                                    ToolTip.Tip="Watch Replay"
                                    Command="{Binding $parent[DataGrid].((vm:DataPageViewModel)DataContext).LaunchReplayCommand}"
                                    CommandParameter="{Binding}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
            <DataGrid.RowDetailsTemplate>
                <DataTemplate x:DataType="vm:GameDataRowViewModel">
                    <Grid Margin="24,8" ColumnDefinitions="Auto,24,*">
                        <StackPanel Grid.Column="0" Spacing="8" MinWidth="320">
                            <TextBlock Text="{Binding SelfTracker.TabHeader}" FontWeight="Bold"/>
                            <local:PlayerBuildTracker DataContext="{Binding SelfTracker}"/>
                        </StackPanel>

                        <GridSplitter Grid.Column="1" ResizeDirection="Columns" Width="3" />

                        <StackPanel Grid.Column="2" Spacing="8">
                            <TabControl ItemsSource="{Binding OtherPlayers}">
                                <TabControl.Styles>
                                    <Style Selector="TabItem">
                                        <Setter Property="MinHeight" Value="16" />
                                        <Setter Property="Padding" Value="4,0" />
                                        <Setter Property="FontSize" Value="14" />
                                        <Setter Property="FontWeight" Value="Bold" />
                                        <Setter Property="Margin" Value="7, -2, 0, -5" />
                                    </Style>
                                    <Style Selector="TabItem:selected /template/ Border#PART_SelectedPipe">
                                        <Setter Property="Margin" Value="0, 20, 0, 0" />
                                    </Style>
                                </TabControl.Styles>
                                <TabControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:PlayerBuildTrackerViewModel">
                                        <TextBlock Text="{Binding TabHeader}" Foreground="{Binding NameColor}"/>
                                    </DataTemplate>
                                </TabControl.ItemTemplate>
                                <TabControl.ContentTemplate>
                                    <DataTemplate x:DataType="vm:PlayerBuildTrackerViewModel">
                                        <local:PlayerBuildTracker Margin="0,8,0,0"/>
                                    </DataTemplate>
                                </TabControl.ContentTemplate>
                            </TabControl>
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </DataGrid.RowDetailsTemplate>
        </DataGrid>
    </DockPanel>
</UserControl>
