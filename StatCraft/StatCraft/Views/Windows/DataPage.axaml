<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:StatCraft.ViewModels"
             xmlns:local="using:StatCraft.Views"
             xmlns:component="using:StatCraft.Views.Components"
              x:Class="StatCraft.Views.DataPage"
             x:DataType="vm:DataPageViewModel">
    <DockPanel>
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="12" Margin="8">
            <TextBlock Text="{Binding ActiveProfileLabel}" FontSize="16" VerticalAlignment="Center"/>
            <Button Content="Begin Session" Command="{Binding BeginSessionCommand}"/>
        </StackPanel>

        <DataGrid ItemsSource="{Binding Games}" AutoGenerateColumns="False"
                  RowDetailsVisibilityMode="VisibleWhenSelected" GridLinesVisibility="Horizontal">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Date/Time" Binding="{Binding PlayedAt}" IsReadOnly="True"/>
                <DataGridTextColumn Header="Map" Binding="{Binding MapName}" IsReadOnly="True"/>
                <DataGridTemplateColumn Header="Result">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="vm:GameDataRowViewModel">
                            <TextBlock Text="{Binding ResultLabel}" Foreground="{Binding ResultColor}"
                                       VerticalAlignment="Center" Margin="4,0"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Length" Binding="{Binding GameLength}" IsReadOnly="True"/>
                <DataGridTemplateColumn Header="Matchup">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="vm:GameDataRowViewModel">
                            <component:ColoredTextBlock Characters="{Binding MatchupCharacters}"
                                                     VerticalAlignment="Center" Margin="4,0"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Opponent" Binding="{Binding OpponentName}" IsReadOnly="True"/>
                <DataGridTextColumn Header="Build" Binding="{Binding SelfTracker.SelectedBuildsSummary}" IsReadOnly="True"/>
                <DataGridTextColumn Header="Notes" Binding="{Binding Notes}" Width="*"/>
            </DataGrid.Columns>
            <DataGrid.RowDetailsTemplate>
                <DataTemplate x:DataType="vm:GameDataRowViewModel">
                    <Grid Margin="24,8" ColumnDefinitions="Auto,24,*">
                        <StackPanel Grid.Column="0" Spacing="8" MinWidth="320">
                            <TextBlock Text="Your Build" FontWeight="Bold"/>
                            <local:PlayerBuildTracker DataContext="{Binding SelfTracker}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2" Spacing="8">
                            <TextBlock Text="Other Players" FontWeight="Bold"/>
                            <TabControl ItemsSource="{Binding OtherPlayers}">
                                <TabControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:OtherPlayerBuildViewModel">
                                        <TextBlock Text="{Binding TabHeader}"/>
                                    </DataTemplate>
                                </TabControl.ItemTemplate>
                                <TabControl.ContentTemplate>
                                    <DataTemplate x:DataType="vm:OtherPlayerBuildViewModel">
                                        <local:PlayerBuildTracker DataContext="{Binding Tracker}" Margin="0,8,0,0"/>
                                    </DataTemplate>
                                </TabControl.ContentTemplate>
                            </TabControl>
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </DataGrid.RowDetailsTemplate>
        </DataGrid>
    </DockPanel>
</UserControl>
