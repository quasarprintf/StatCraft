<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:StatCraft.ViewModels"
             xmlns:builds="using:StatCraft.Models.GameData.Builds"
             xmlns:local="using:StatCraft.Views"
             x:Class="StatCraft.Views.BuildsPage"
             x:DataType="vm:BuildsPageViewModel">
    <DockPanel>
        <!-- Player race / opponent race selectors -->
        <StackPanel DockPanel.Dock="Top" Spacing="4" Margin="4">
            <DockPanel>
                <TextBlock Text="You:" VerticalAlignment="Center" Width="80"/>
                <ItemsControl ItemsSource="{Binding PlayerRaceOptions}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="4"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:RaceOption">
                            <Button Content="{Binding Value}"
                                    Command="{Binding $parent[ItemsControl].((vm:BuildsPageViewModel)DataContext).SelectPlayerRaceCommand}"
                                    CommandParameter="{Binding Value}"
                                    Classes.active="{Binding IsSelected}"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </DockPanel>
            <DockPanel>
                <TextBlock Text="Opponent:" VerticalAlignment="Center" Width="80"/>
                <ItemsControl ItemsSource="{Binding OpponentRaceOptions}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="4"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:RaceOption">
                            <Button Content="{Binding Value}"
                                    Command="{Binding $parent[ItemsControl].((vm:BuildsPageViewModel)DataContext).SelectOpponentRaceExclusiveCommand}"
                                    CommandParameter="{Binding Value}"
                                    RightTapped="OnOpponentRaceRightTapped"
                                    Classes.active="{Binding IsSelected}"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </DockPanel>
        </StackPanel>

        <!-- Left/right split -->
        <Grid ColumnDefinitions="200,4,*">
            <!-- Build tree -->
            <DockPanel Grid.Column="0">
                <TreeView x:Name="BuildTreeView" ItemsSource="{Binding Builds}" SelectedItem="{Binding SelectedBuild}">
                    <TreeView.Resources>
                        <!-- Widen the built-in per-level indent (default 16) so depth is easier to read at a glance. -->
                        <x:Double x:Key="TreeViewItemIndent">28</x:Double>
                    </TreeView.Resources>
                    <TreeView.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Add Build" Command="{Binding AddBuildCommand}"/>
                        </ContextMenu>
                    </TreeView.ContextMenu>
                    <TreeView.Styles>
                        <Style Selector="TreeViewItem" x:DataType="builds:BuildNode">
                            <Setter Property="IsExpanded" Value="{Binding IsExpanded}"/>
                            <Setter Property="IsVisible" Value="{Binding MatchesOpponentFilter}"/>
                            <!-- Root builds stand out in bold; nested builds are normal weight, so the top of
                                 each subtree is obvious even before reading the indentation. -->
                            <Setter Property="FontWeight" Value="Bold"/>
                            <!-- A vertical guide line at each row's own indent, reinforcing the step down per
                                 level (BorderBrush/Thickness are standard TemplatedControl properties the
                                 theme's own template already binds through to its header border). -->
                            <Setter Property="BorderThickness" Value="1,0,0,0"/>
                            <Setter Property="BorderBrush" Value="Gray"/>
                            <Setter Property="Padding" Value="4,2,2,2"/>
                            <Setter Property="ContextMenu">
                                <Template>
                                    <ContextMenu>
                                        <MenuItem Header="Add Child"
                                                  Command="{Binding #BuildTreeView.DataContext.AddChildBuildCommand}"
                                                  CommandParameter="{Binding}"/>
                                        <Separator/>
                                        <MenuItem Header="Delete Build"
                                                  Command="{Binding #BuildTreeView.DataContext.DeleteBuildCommand}"
                                                  CommandParameter="{Binding}"/>
                                    </ContextMenu>
                                </Template>
                            </Setter>
                        </Style>
                        <!-- Any nested (non-root) item — descendant combinator, matches every depth below root. -->
                        <Style Selector="TreeViewItem TreeViewItem">
                            <Setter Property="FontWeight" Value="Normal"/>
                        </Style>
                    </TreeView.Styles>
                    <TreeView.ItemTemplate>
                        <TreeDataTemplate ItemsSource="{Binding Children}">
                            <TextBlock Text="{Binding Name}"/>
                        </TreeDataTemplate>
                    </TreeView.ItemTemplate>
                </TreeView>
            </DockPanel>

            <GridSplitter Grid.Column="1" ResizeDirection="Columns"/>

            <local:BuildDetailsPanel Grid.Column="2"/>
        </Grid>
    </DockPanel>
</UserControl>
