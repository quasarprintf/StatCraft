<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vmw="using:StatCraft.ViewModels.Windows"
             xmlns:Attr="using:StatCraft.Models.GameData.Attributes"
             x:Class="StatCraft.Views.Windows.MapsComponents.MapDetailsPanel"
             x:DataType="vmw:MapsPageViewModel">
    <DockPanel Margin="12">
        <StackPanel DockPanel.Dock="Top" Spacing="6">
            <TextBlock Text="Name" FontWeight="SemiBold"/>
            <TextBox Text="{Binding SelectedMap.Name}"/>

            <TextBlock Text="Attributes" FontWeight="SemiBold" Margin="0,8,0,0"/>
        </StackPanel>

        <ScrollViewer>
            <ItemsControl ItemsSource="{Binding SelectedMap.AttributeValues}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="Attr:AttributeValue">
                        <StackPanel Margin="0,0,0,8">
                            <!-- Definition name, read-only here — name/type/options are only editable
                                 from the Attributes tab; this page only edits the per-map value below. -->
                            <TextBlock Text="{Binding Definition.Name}" FontWeight="SemiBold"/>

                            <!-- This map's value. Every editor is nullable, and the clear button puts it
                                 back to unset — which is stored as the absence of a row, not as 0/false. -->
                            <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,4,0,0" IsVisible="{Binding !Definition.IsValues}">
                                <TextBlock Grid.Column="0" Text="Value:" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <NumericUpDown Grid.Column="1" Value="{Binding NumericValue}"
                                               IsVisible="{Binding Definition.IsNumeric}"
                                               FormatString="0.##" HorizontalAlignment="Stretch"/>
                                <CheckBox Grid.Column="1" IsChecked="{Binding BoolValue}" IsThreeState="True"
                                          IsVisible="{Binding Definition.IsBool}"/>
                                <NumericUpDown Grid.Column="1" Value="{Binding PercentValue}"
                                               IsVisible="{Binding Definition.IsPercent}"
                                               Minimum="0" Maximum="100" FormatString="0.##'%'"
                                               HorizontalAlignment="Stretch"/>
                                <Button Grid.Column="2" Content="Clear" Padding="6,2" Margin="4,0,0,0"
                                        Command="{Binding ClearCommand}"/>
                            </Grid>

                            <!-- Values type: picking this map's value from the shared option list — the
                                 option list itself is only editable from the Attributes tab. -->
                            <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,4,0,0" IsVisible="{Binding Definition.IsValues}">
                                <TextBlock Grid.Column="0" Text="Value:" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <ComboBox Grid.Column="1" ItemsSource="{Binding Definition.ValueOptions}"
                                          SelectedItem="{Binding SelectedValue}"
                                          HorizontalAlignment="Stretch"/>
                                <Button Grid.Column="2" Content="Clear" Padding="6,2" Margin="4,0,0,0"
                                        Command="{Binding ClearCommand}"/>
                            </Grid>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</UserControl>
