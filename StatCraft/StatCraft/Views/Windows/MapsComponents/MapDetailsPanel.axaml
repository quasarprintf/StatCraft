<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vmw="using:StatCraft.ViewModels.Windows"
             xmlns:Attr="using:StatCraft.Models.GameData.Attributes"
             xmlns:attributescomponents="using:StatCraft.Views.Windows.AttributesComponents"
             xmlns:conv="using:StatCraft.Services.Converters"
             x:Class="StatCraft.Views.Windows.MapsComponents.MapDetailsPanel"
             x:DataType="vmw:MapsPageViewModel"
             Name="mapDetails">
    <DockPanel Margin="12">
        <StackPanel DockPanel.Dock="Top" Spacing="6">
            <TextBlock Text="Name" FontWeight="SemiBold"/>
            <TextBox Text="{Binding SelectedMap.Name}"/>
        </StackPanel>

        <attributescomponents:AttributeValuesSelect DockPanel.Dock="Top"
                    DataContext="{Binding AttributeValuesSelect}" />
    </DockPanel>
</UserControl>
