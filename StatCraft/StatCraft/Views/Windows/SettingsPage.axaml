<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:StatCraft.ViewModels"
             x:Class="StatCraft.Views.SettingsPage"
             x:DataType="vm:SettingsPageViewModel">
    <StackPanel Margin="16" Spacing="8" MaxWidth="480" HorizontalAlignment="Left">
        <TextBlock Text="Replay Folder" FontWeight="SemiBold"/>
        <TextBlock TextWrapping="Wrap" Foreground="Gray">
            The folder StatCraft watches for new replays, one level above each linked account's own
            folder. On Windows, this is typically
            <LineBreak />
            C:\Users\{user}\Documents\StarCraft II
        </TextBlock>

        <Grid ColumnDefinitions="*,Auto" Margin="0,8,0,0">
            <TextBox Grid.Column="0" Text="{Binding BaseReplayFolderPath}" Margin="0,0,4,0"/>
            <Button Grid.Column="1" Content="Browse..." Click="OnBrowseClick"/>
        </Grid>

        <TextBlock Text="{Binding ErrorMessage}" Foreground="Red" TextWrapping="Wrap"
                   IsVisible="{Binding HasError}"/>
        <TextBlock Text="Saved." Foreground="Green" IsVisible="{Binding JustSaved}"/>

        <Button Content="Save" Command="{Binding SaveCommand}" Margin="0,8,0,0"/>
    </StackPanel>
</UserControl>
