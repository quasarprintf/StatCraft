<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vmw="using:StatCraft.ViewModels.Windows"
             xmlns:maps="using:StatCraft.Models.GameData.Maps"
             xmlns:local="using:StatCraft.Views.Windows.MapsComponents"
             xmlns:filters="using:StatCraft.Views.Components.Filters"
             x:Class="StatCraft.Views.Windows.MapsPage"
             x:DataType="vmw:MapsPageViewModel">
    <Grid ColumnDefinitions="240,4,*">
        <!-- Left: name filter + attribute filters, then the map list -->
        <DockPanel Grid.Column="0" Margin="4">
            <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,4">
                <TextBox Grid.Column="0" Text="{Binding NameFilter}" PlaceholderText="Filter maps..." Margin="0,0,4,0"/>
                <filters:AddFilterMenu Grid.Column="1" DataContext="{Binding FilterMenu}" />
            </Grid>

            <!-- Attribute filters stack vertically here rather than in a horizontal bar, because the
                 left pane is narrow and the slot count grows with the number of defined attributes. -->
            <filters:FilterBar DockPanel.Dock="Top" DataContext="{Binding FilterMenu}" Orientation="Vertical" Spacing="4" />

            <ListBox x:Name="MapListBox" ItemsSource="{Binding FilteredMaps}" SelectedItem="{Binding SelectedMap}">
                <ListBox.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Add Map" Command="{Binding AddMapCommand}"/>
                    </ContextMenu>
                </ListBox.ContextMenu>
                <ListBox.Styles>
                    <Style Selector="ListBoxItem" x:DataType="maps:Map">
                        <Setter Property="ContextMenu">
                            <Template>
                                <ContextMenu>
                                    <MenuItem Header="Add Map" Command="{Binding #MapListBox.DataContext.AddMapCommand}"/>
                                    <Separator/>
                                    <MenuItem Header="Delete Map"
                                              Command="{Binding #MapListBox.DataContext.DeleteMapCommand}"
                                              CommandParameter="{Binding}"/>
                                </ContextMenu>
                            </Template>
                        </Setter>
                    </Style>
                </ListBox.Styles>
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="maps:Map">
                        <TextBlock Text="{Binding Name}"/>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <GridSplitter Grid.Column="1" ResizeDirection="Columns"/>

        <local:MapDetailsPanel Grid.Column="2"/>
    </Grid>
</UserControl>
