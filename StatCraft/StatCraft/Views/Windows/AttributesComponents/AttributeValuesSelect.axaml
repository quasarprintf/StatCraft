<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vmw="using:StatCraft.ViewModels.Windows.AttributeComponents"
             xmlns:Attr="using:StatCraft.Models.GameData.Attributes"
             xmlns:conv="using:StatCraft.Services.Converters"
             x:Class="StatCraft.Views.Windows.AttributesComponents.AttributeValuesSelect"
             x:DataType="vmw:AttributeValuesSelectViewModel"
             Name="attributeValueSelect">
    <StackPanel>
        <!-- Opacity/IsHitTestVisible rather than IsVisible, so the button keeps reserving its layout
            space while hidden instead of the page shifting when there's nothing left to add. -->
        <Button x:Name="AddAttributeButton" DockPanel.Dock="Top" Grid.Column="1" Content="Add attribute" Padding="6,2" VerticalAlignment="Center"
                Opacity="{Binding HasUnusedAttributes, Converter={x:Static conv:BoolToOpacityConverter.Instance}}"
                IsHitTestVisible="{Binding HasUnusedAttributes}">
            <Button.Flyout>
                <Flyout Placement="BottomEdgeAlignedRight">
                    <ItemsControl ItemsSource="{Binding UnusedAttributes}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Content="{Binding  Name}"
                                        Command="{Binding ((vmw:AttributeValuesSelectViewModel)DataContext).AddAttributeCommand, ElementName=attributeValueSelect}"
                                        CommandParameter="{Binding .}"
                                        Click="OnAddAttributeOptionClicked"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Flyout>
            </Button.Flyout>
        </Button>

        <ScrollViewer>
            <ItemsControl ItemsSource="{Binding Object.AttributeValues}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="Attr:AttributeValue">
                        <StackPanel Margin="0,0,0,8">
                            <!-- Definition name, read-only here — name/type/options are only editable
                                    from the Attributes tab; this page only edits the per-map value below. -->
                            <TextBlock Text="{Binding Definition.Name}" FontWeight="SemiBold"/>

                            <!-- This map's value. Every editor is nullable, and the clear button puts it
                                    back to unset — which is stored as the absence of a row, not as 0/false. -->
                            <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,4,0,0" IsVisible="{Binding !Definition.IsValues}">
                                <TextBlock Grid.Column="0" Text="Value:" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <NumericUpDown Grid.Column="1" Value="{Binding NumericValue}"
                                                IsVisible="{Binding Definition.IsNumeric}"
                                                FormatString="0.##" HorizontalAlignment="Stretch"/>
                                <CheckBox Grid.Column="1" IsChecked="{Binding BoolValue}" IsThreeState="True"
                                            IsVisible="{Binding Definition.IsBool}"/>
                                <NumericUpDown Grid.Column="1" Value="{Binding PercentValue}"
                                                IsVisible="{Binding Definition.IsPercent}"
                                                Minimum="0" Maximum="100" FormatString="0.##'%'"
                                                HorizontalAlignment="Stretch"/>

                                <Button Grid.Column="2" Content="x" IsVisible="{Binding !Definition.IsMandatory}" Padding="6,2" Margin="4,0,28,0"
                                        Command="{Binding ((vmw:AttributeValuesSelectViewModel)DataContext).RemoveAttributeCommand, ElementName=attributeValueSelect}"
                                        CommandParameter="{Binding .}" />
                                <Button Grid.Column="2" Content="Clear" IsVisible="{Binding Definition.IsMandatory}" Padding="6,2" Margin="4,0,0,0"
                                        Command="{Binding ClearCommand}"/>
                            </Grid>

                            <!-- Values type: picking this map's value from the shared option list — the
                                    option list itself is only editable from the Attributes tab. -->
                            <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,4,0,0" IsVisible="{Binding Definition.IsValues}">
                                <TextBlock Grid.Column="0" Text="Value:" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <ComboBox Grid.Column="1" ItemsSource="{Binding Definition.ValueOptions}"
                                            SelectedItem="{Binding SelectedValue}"
                                            HorizontalAlignment="Stretch"/>
                                <Button Grid.Column="2" Content="x" IsVisible="{Binding !Definition.IsMandatory}" Padding="6,2" Margin="4,0,28,0"
                                        Command="{Binding ((vmw:AttributeValuesSelectViewModel)DataContext).RemoveAttributeCommand, ElementName=attributeValueSelect}"
                                        CommandParameter="{Binding .}" />
                                <Button Grid.Column="2" Content="Clear" IsVisible="{Binding Definition.IsMandatory}" Padding="6,2" Margin="4,0,0,0"
                                        Command="{Binding ClearCommand}"/>
                            </Grid>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </StackPanel>
</UserControl>
