<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vmw="using:StatCraft.ViewModels.Windows"
             xmlns:filters="using:StatCraft.Views.Components.Filters"
             xmlns:dc="using:StatCraft.Views.Windows.DataComponents"
             x:Class="StatCraft.Views.Components.Filters.BuildFilter"
             x:DataType="vmw:Filters.IBuildFilterSlotViewModel">
    <StackPanel Spacing="2" VerticalAlignment="Center">
        <Grid ColumnDefinitions="Auto,*">
            <Button Grid.Column="0" Classes="removeFilter" Command="{Binding RemoveCommand}" IsVisible="{Binding !Mandatory}"/>
            <TextBlock Grid.Column="1" Text="{Binding Title}" VerticalAlignment="Center"
                    TextTrimming="CharacterEllipsis" FontWeight="SemiBold"/>
        </Grid>
        <!-- Reads as the picked build, since that is what the popup behind it is mostly for: the picker,
             and then whatever details the build that was picked records. -->
        <Button MinWidth="120" MaxWidth="200" HorizontalContentAlignment="Left">
            <TextBlock Text="{Binding BuildSelection.SelectedBuildLabel}" TextTrimming="CharacterEllipsis"/>
            <Button.Flyout>
                <Flyout Placement="BottomEdgeAlignedLeft">
                    <StackPanel MinWidth="220" Spacing="4">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <RadioButton Content="Me" IsChecked="{Binding AppliesToMe}"/>
                            <RadioButton Content="Ally" IsChecked="{Binding AppliesToAlly}"/>
                            <RadioButton Content="Opponent" IsChecked="{Binding AppliesToOpponent}"/>
                        </StackPanel>
                        <!-- The same picker a game row uses, over this matchup's build tree. -->
                        <dc:BuildPathPicker DataContext="{Binding BuildSelection}"/>
                        <CheckBox Content="Include descendants" IsChecked="{Binding IncludeDescendants}" FontSize="11"/>
                        <ScrollViewer MaxHeight="480">
                            <ItemsControl ItemsSource="{Binding BuildDetailSlots}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Vertical" Spacing="2"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <filters:FilterSlot />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </StackPanel>
                </Flyout>
            </Button.Flyout>
        </Button>
    </StackPanel>
</UserControl>
