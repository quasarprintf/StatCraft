<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vmw="using:StatCraft.ViewModels.Windows"
             xmlns:filters="using:StatCraft.Views.Components.Filters"
             xmlns:dc="using:StatCraft.Views.Windows.DataComponents"
             x:Class="StatCraft.Views.Components.Filters.BuildFilter"
             x:DataType="vmw:Filters.IBuildFilterSlotViewModel">
    <StackPanel Spacing="2" VerticalAlignment="Center">
        <Grid ColumnDefinitions="Auto,*">
            <Button Grid.Column="0" Classes="removeFilter" Command="{Binding RemoveCommand}" IsVisible="{Binding !Mandatory}"/>
            <TextBlock Grid.Column="1" Text="{Binding Title}" VerticalAlignment="Center"
                    TextTrimming="CharacterEllipsis" FontWeight="SemiBold"/>
        </Grid>
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="2">
            <!-- The same picker a game row uses, over this matchup's build tree. -->
            <dc:BuildPathPicker Grid.Column="0" MinWidth="120" DataContext="{Binding BuildSelection}"/>
            <!-- Only the picked build's own details can be filtered on, so there is nothing behind this
                 until a build with details is picked. -->
            <Button Grid.Column="1" Content="Details" IsVisible="{Binding HasDetails}">
                <Button.Flyout>
                    <Flyout Placement="BottomEdgeAlignedLeft">
                        <ScrollViewer MaxHeight="480">
                            <ItemsControl ItemsSource="{Binding BuildDetailSlots}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Vertical" Spacing="2"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <filters:FilterSlot />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Flyout>
                </Button.Flyout>
            </Button>
        </Grid>
        <CheckBox Content="Include descendants" IsChecked="{Binding IncludeDescendants}" FontSize="11"/>
    </StackPanel>
</UserControl>
