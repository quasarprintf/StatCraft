<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vmw="using:StatCraft.ViewModels.Windows"
             x:Class="StatCraft.Views.Components.Filters.FilterSlotHeader"
             x:DataType="vmw:Filters.FilterSlotViewModel">
    <Grid ColumnDefinitions="*,Auto">
        <TextBlock Grid.Column="0" Text="{Binding Title}" VerticalAlignment="Center"
                   TextTrimming="CharacterEllipsis" FontWeight="SemiBold"/>
        <Button Grid.Column="1" Classes="removeFilter" Command="{Binding RemoveCommand}"/>
    </Grid>
</UserControl>
