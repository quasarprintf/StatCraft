<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vmw="using:StatCraft.ViewModels.Windows"
             xmlns:filters="using:StatCraft.Views.Components.Filters"
             x:DataType="vmw:Filters.FilterMenuViewModel"
             x:Class="StatCraft.Views.Components.Filters.FilterBar">
    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">

        <ItemsControl ItemsSource="{Binding VisibleExtraFilterSlots}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" Spacing="8"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <filters:FilterSlot />
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
</UserControl>
