<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vmw="using:StatCraft.ViewModels.Windows"
             x:Class="StatCraft.Views.Components.Filters.NumericRangeFilter"
             x:DataType="vmw:Filters.INumericRangeFilterSlotViewModel"
             x:Name="Root">
    <StackPanel Spacing="2" VerticalAlignment="Center">
        <Grid ColumnDefinitions="Auto,*">
            <Button Grid.Column="0" Classes="removeFilter" Command="{Binding RemoveCommand}"/>
            <TextBlock Grid.Column="1" Text="{Binding Title}" VerticalAlignment="Center"
                    TextTrimming="CharacterEllipsis" FontWeight="SemiBold"/>
        </Grid>
        <StackPanel Classes="filterSlot">
            <NumericUpDown Value="{Binding Min}" Width="90" PlaceholderText="Min" FormatString="0.##" ShowButtonSpinner="False"/>
            <TextBlock Text="-" VerticalAlignment="Center"/>
            <NumericUpDown Value="{Binding Max}" Width="90" PlaceholderText="Max" FormatString="0.##" ShowButtonSpinner="False"/>
        </StackPanel>
        <CheckBox Content="Include unset" IsChecked="{Binding IncludeUnset}" IsVisible="{Binding AllowIncludeUnset}" FontSize="11"/>
    </StackPanel>
</UserControl>
