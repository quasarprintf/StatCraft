<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:style="using:StatCraft.Styles"
             xmlns:local="using:StatCraft.Views.Components"
             x:Class="StatCraft.Views.Components.ColoredTextBlock">
    <ItemsControl ItemsSource="{Binding $parent[local:ColoredTextBlock].Characters}">
        <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
                <StackPanel Orientation="Horizontal"/>
            </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="style:ColoredCharacter">
                <TextBlock Text="{Binding Text}" Foreground="{Binding Color}"/>
            </DataTemplate>
        </ItemsControl.ItemTemplate>
    </ItemsControl>
</UserControl>
